<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FBFBFB"
        android:orientation="vertical"
        tools:context=".ui.StoryPlayerListActivity">

        <!-- 상단 타이틀 메뉴 -->
        <RelativeLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="#F2353B49"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tmp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="20dp"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="left|center_vertical"
                android:text="@string/playlist"
                android:textColor="#FFFFFF"
                android:textSize="14dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dp"
                android:layout_toRightOf="@id/tmp"
                android:focusable="false"
                android:fontFamily="@font/vk_regular"
                android:gravity="left|center_vertical"
                android:text="0"
                android:textColor="#14C1EF"
                android:textSize="14dp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="14dp"
                android:background="@drawable/ic_bt_top_closew"
                android:contentDescription="@string/close"
                android:focusable="true" />

        </RelativeLayout>

        <!-- clipChildren false to true로 변경함-->
        <RelativeLayout
