                            android:layout_marginLeft="31dp"
                            android:layout_toRightOf="@id/btn_play_list_play"
                            android:background="@drawable/ic_bt_player_next"
                            android:contentDescription="@string/audio_next" />

                        <ImageView
                            android:id="@+id/btn_play_list_prev"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_centerVertical="true"
                            android:layout_marginRight="31dp"
                            android:layout_toLeftOf="@id/btn_play_list_play"
                            android:background="@drawable/ic_bt_player_prev"
                            android:contentDescription="@string/audio_prev" />

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/iv_thumb"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:layout_marginRight="14dp" />
                    </RelativeLayout>
                    -->

                <!-- 기타하단 모음 -->
                <include
                    android:id="@+id/toast_menu"
                    layout="@layout/bottom_toast_menu_play_list_edit"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <RelativeLayout
                    android:id="@+id/dump_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    tools:visibility="gone" />
            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>

</layout>

