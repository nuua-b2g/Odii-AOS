            <!-- 위치보기용 뷰가 들어갈 영역 clickable true, 덮어진 뷰로 클릭이벤트 전달됨을 방지 -->
            <RelativeLayout
                android:id="@+id/layout_map_showing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/view_bottom_area"
                android:layout_below="@id/layout_view_play_edit"
                android:background="#ffffffff"
                android:clickable="true"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:id="@+id/iv_dumpimage_for_infowindow"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:screenReaderFocusable="false"></ImageView>

                <!-- 네이버 지도가 들어갈 위치 -->
                <LinearLayout
                    android:id="@+id/view_map_area"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    tools:background="#74FF3F3F">
