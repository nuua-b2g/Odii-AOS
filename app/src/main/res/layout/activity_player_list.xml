                </LinearLayout>
                <!--목록보기 : 목록으로 돌아가기 끝-->

            </RelativeLayout>

            <!-- view_bottom_area -->
            <RelativeLayout
                android:id="@+id/view_bottom_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:clipChildren="false"
                android:cropToPadding="false">
                <!-- view_player 를 대체하는 MiniPlayerView -->
                <kto.smarttour.ui.view.MiniPlayerView
                    android:id="@+id/view_mini_player"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:cropToPadding="false"
                    android:visibility="gone"
                    tools:visibility="visible" />
                <!-- view_mini_player 대체
                    <RelativeLayout
                        android:id="@+id/view_player"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_alignParentBottom="true"
                        android:background="#E6000000"
                        android:clickable="true"
                        android:focusable="true">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btn_play_list_play"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/ic_bt_player_play"
                            android:contentDescription="@string/audio_play" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btn_play_list_pause"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
