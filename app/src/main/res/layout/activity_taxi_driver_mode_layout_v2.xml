<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/main_activity"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/layout_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/topbar"
            android:layout_alignParentBottom="true">

            <!-- constraint 사용으로 추가 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#ffffffff">

                <!-- 배경 컬러 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="#241b2a"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"></LinearLayout>

                <!-- 앨범아트 468x434-->
                <ImageView
                    android:id="@+id/iv_thumb"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="60dp"
                    android:contentDescription="TODO"
                    app:layout_constraintBottom_toTopOf="@id/media_controller"
                    app:layout_constraintDimensionRatio="468:434"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:src="@drawable/ic_launcher" />

                <!-- 컨트롤 -->
                <RelativeLayout
                    android:id="@+id/media_controller"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:0.78">

                    <TextView
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:maxLines="2"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="20dp"
                        tools:text="관광택시 오디오 제목" />

                    <!-- 시크바영역-->
                    <RelativeLayout
                        android:id="@+id/layout_seek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/title"
                        android:layout_marginStart="60dp"
                        android:layout_marginEnd="60dp">
                        <!--
                        android:layout_toLeftOf="@id/timer_start"
                        android:layout_toRightOf="@id/timer_end"
                        -->
                        <androidx.appcompat.widget.AppCompatSeekBar
                            android:id="@+id/seek_arc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/timer_end"
                            android:layout_toEndOf="@id/timer_start"
                            android:max="100"
                            android:maxHeight="4dp"
                            android:minHeight="4dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/taxi_progressbar_v2"
                            android:splitTrack="false"
                            android:thumb="@android:color/transparent"
                            android:thumbTint="@android:color/transparent" />

                        <!-- 현재 진행길이 시간표시-->
                        <TextView
                            android:id="@+id/timer_start"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:layout_marginTop="0dp"
                            android:layout_marginRight="0dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="left|center_vertical"
                            android:textColor="#FFFFFF"
                            android:textSize="14dp"
                            android:text="0:00"
                            tools:text="00:00" />

                        <!-- 전체 재생길이 시간표시 -->
                        <TextView
                            android:id="@+id/timer_end"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginLeft="0dp"
                            android:layout_marginTop="0dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="right|center_vertical"
                            android:textColor="#FFFFFF"
                            android:textSize="14dp"
                            android:text="0:00"
                            tools:text="99:99" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_marginTop="24dp"
                        android:layout_below="@id/layout_seek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- ic_tx_player_play -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btn_player_play"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"
                            android:background="@drawable/tx_img_player_play" />

                        <!-- ic_tx_player_pause -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btn_player_pause"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"
                            android:background="@drawable/tx_img_player_pause" />

                        <!-- v2 숨김 -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:visibility="invisible"
                            android:id="@+id/btn_player_prev"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_centerVertical="true"
                            android:layout_toLeftOf="@id/btn_player_play"
                            android:background="@drawable/ic_tx_player_prev" />
                        <!-- v2 숨김 -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:visibility="invisible"
                            android:id="@+id/btn_player_next"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_centerVertical="true"
                            android:layout_toRightOf="@id/btn_player_play"
                            android:background="@drawable/ic_tx_player_nest" />

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/timer"
                        android:layout_width="124dp"
                        android:layout_height="40dp"
                        android:layout_alignParentBottom="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textSize="14dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@id/title">




                    </RelativeLayout>

                </RelativeLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layout_info"
            android:background="#000000"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/driver_story_item" />

        <!-- android:background="#E6242932" to ffffffff-->
        <RelativeLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#ffffffff">

            <!-- v2 숨김 -->
            <TextView
                android:visibility="gone"
                android:id="@+id/tv_story_count"
                style="@style/font_letterSpacing_Num"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="10dp"
                android:fontFamily="@font/vk_medium"
                android:gravity="left|center_vertical"
                android:text="1 / 100"
                android:textColor="#FFFFFF"
                android:textSize="18dp" />

            <!-- v 2숨김 -->
            <TextView
                android:visibility="gone"
                android:id="@+id/tv_story_tmp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toRightOf="@id/tv_story_count"
                android:gravity="left|center_vertical"
                android:text="@string/story"
                android:textColor="#80FFFFFF"
                android:textSize="18dp" />

            <!-- v2 변경
            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_alignParentRight="true"
                android:background="@drawable/ic_tx_bt_playclose"
                android:contentDescription="TODO" />

            <ImageView
                android:id="@+id/btn_rotation"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_toLeftOf="@id/btn_close"
                android:background="@drawable/ic_tx_bt_mode02"
                android:contentDescription="TODO" />

            <TextView
                android:id="@+id/btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:layout_toLeftOf="@id/btn_rotation"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/edit_list"
                android:textColor="#FFFFFF"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/btn_edit_complete"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:layout_toLeftOf="@id/btn_rotation"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/msg_edit_complete"
                android:textColor="#696CFF"
                android:textSize="18dp"
                android:visibility="gone" />
             -->
            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:background="@drawable/tx_img_player_close"
                android:contentDescription="TODO" />

            <TextView
                android:id="@+id/btn_close_right"
                android:text="종료"
                android:textSize="16dp"
                android:gravity="center"
                android:layout_width="54dp"
                android:layout_height="28dp"
                android:layout_marginRight="20dp"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:textColor="#ff000000"
                android:background="@drawable/box_circle_gray_4dp"
                android:contentDescription="TODO" />

            <TextView
                android:id="@+id/tv_taxi_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"
                android:layout_toRightOf="@id/btn_close"
                android:layout_toLeftOf="@id/btn_close_right"
                android:text=""
                android:textColor="#000000"
                android:textSize="20dp"
                tools:text="Odii 관광택시 - 타이틀"/>

            <ImageView
                android:id="@+id/btn_rotation"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_toRightOf="@id/btn_close"
                android:background="@drawable/ic_tx_bt_mode02"
                android:contentDescription="TODO" />

            <TextView
                android:id="@+id/btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:layout_toRightOf="@id/btn_rotation"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/edit_list"
                android:textColor="#FFFFFF"
                android:textSize="18dp" />

            <TextView
                android:id="@+id/btn_edit_complete"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:layout_toRightOf="@id/btn_rotation"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/msg_edit_complete"
                android:textColor="#696CFF"
                android:textSize="18dp"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- layout_safety 제거한속성
        android:layout_above="@id/layout_info"
            android:layout_alignLeft="@id/list"
            android:layout_alignTop="@id/list"
            android:layout_alignRight="@id/list"
            android:layout_alignBottom="@id/list"
        -->
        <!-- RelativeLayout to ConstraintLayout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_safety"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="gone">

            <!-- 594,942 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="#ffffff"
                android:visibility="visible"
                android:id="@+id/view_step_one"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="594:942">

                <ImageView
                    android:id="@+id/iv_safety"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginHorizontal="80dp"
                    app:layout_constraintDimensionRatio="1"
                    android:layout_marginTop="32dp"
                    android:layout_width="0dp" android:contentDescription="TODO"
                    android:layout_height="0dp"
                    android:background="@drawable/tx_img_tx_safety" />

                <LinearLayout
                    android:id="@+id/linear_safety_msg_upper"
                    app:layout_constraintTop_toBottomOf="@id/iv_safety"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="32dp"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="26dp" android:contentDescription="TODO"
                        android:layout_height="26dp"
                        android:background="@drawable/tx_img_tx_safety_triangle" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="0dp"
                        android:layout_marginLeft="4dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="이동중입니다"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="이동중입니다"
                        android:textColor="#000000"
                        android:textSize="24dp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/linear_safety_msg_upper"
                    app:layout_constraintBottom_toTopOf="@id/btn_safety_action"
                    android:layout_marginHorizontal="32dp"
                    android:id="@+id/tv_safety_msg"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="주행중 앱 사용은 운전에 매우 위험합니다. 정차 후 사용해 주세요. 관광지에 도착시 자동 실행됩니다."
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="주행중 앱 사용은\n운전에 매우 위험합니다.\n정차 후 사용해 주세요.\n관광지에 도착시 자동 실행됩니다."
                    android:textColor="#000000"
                    android:textSize="16dp" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btn_safety_action"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginRight="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="@string/confirm"
                    android:contentDescription="@string/confirm"
                    android:textColor="#ffffff"
                    android:background="#593bbd"
                    android:textSize="18dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <RelativeLayout
            android:id="@+id/dump_view"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </RelativeLayout>

</layout>