<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/dump_view"
            android:layout_width="match_parent" android:contentDescription="TODO" 
            android:layout_height="wrap_content"
            android:background="#FBFBFB" />

        <RelativeLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_below="@id/dump_view"
            android:background="#FBFBFB">

            <!-- v2 숨김 -->
            <TextView
                android:visibility="gone"
                android:id="@+id/tv_lang"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_centerVertical="true"
                android:layout_marginLeft="20dp"
                android:background="@drawable/box_driver_en"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="영어"
                android:textSize="13dp" />

            <!--
            <TextView
                android:id="@+id/tv_taxi_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text=""
                android:textColor="#000000"
                android:textSize="20dp"
                tools:text="오디 관광택시 이야기"/>
            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="wrap_content" android:contentDescription="TODO" 
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="20dp"
                android:background="@drawable/ic_bt_top_closeb" />
            -->
            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:background="@drawable/tx_img_player_close"
                android:contentDescription="TODO" />

            <TextView
                android:id="@+id/btn_close_right"
                android:text="종료"
                android:gravity="center"
                android:layout_width="54dp"
                android:layout_height="28dp"
                android:layout_marginRight="20dp"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:textColor="#ff000000"
                android:background="@drawable/box_circle_gray_4dp"
                android:textSize="16dp"
                android:contentDescription="TODO" />

            <TextView
                android:id="@+id/tv_taxi_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"
                android:layout_toRightOf="@id/btn_close"
                android:layout_toLeftOf="@id/btn_close_right"
                android:text=""
                android:textColor="#000000"
                android:textSize="20dp"
                tools:text="Odii 관광택시 - 타이틀"/>

        </RelativeLayout>

        <ImageView
            android:visibility="gone"
            android:id="@+id/tmp1"
            android:layout_width="match_parent" android:contentDescription="TODO" 
            android:layout_height="14dp"
            android:layout_below="@id/topbar"
            android:background="#FBFBFB" />

        <!-- layout_menu 와 layout_lang 순서번경 below 조정-->
        <RelativeLayout
            android:id="@+id/layout_menu"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_below="@id/layout_lang"
            android:orientation="horizontal">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"
                android:background="#F6F6F6" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal">

                <!-- 선택 -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginLeft="20dp"
                    android:id="@+id/tv_tab_selection"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="선택"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="left|center_vertical"
                    android:text="선택"
                    android:textColor="#000000"
                    android:textSize="14dp" />
                <!-- 전체 -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginLeft="20dp"
                    android:id="@+id/tv_tab_all"
                    android:layout_toRightOf="@id/tv_tab_selection"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="전체"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="left|center_vertical"
                    android:text="전체"
                    android:textColor="#000000"
                    android:textSize="14dp" />
                <!-- 전체추가 -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginRight="20dp"
                    android:id="@+id/tv_tab_select_all"
                    android:layout_alignParentRight="true"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="전체"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="left|center_vertical"
                    android:text="전체선택"
                    android:textColor="#000000"
                    android:textSize="14dp" />


                <!--btn_select_all 디자인변경중 치움 -->
                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/btn_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btn_select_all_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/ic_tx_selectall_dis" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/btn_select_all_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="전체선택"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="left|center_vertical"
                        android:text="전체선택"
                        android:textColor="#000000"
                        android:textSize="14dp" />

                </LinearLayout>

                <!--btn_play_all 디자인변경중 치움 -->
                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/btn_play_all"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@id/btn_select_all"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/ic_icon_list_play" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="전체듣기"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="left|center_vertical"
                        android:text="전체듣기"
                        android:textColor="#000000"
                        android:textSize="14dp" />

                </LinearLayout>

                <!-- tv_story_count 디자인번경중 치움 -->
                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/tv_story_count"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="20dp"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_count"
                        style="@style/font_letterSpacing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:fontFamily="@font/vk_medium"
                        android:gravity="left|center_vertical"
                        android:text="15"
                        android:textColor="#000000"
                        android:textSize="14dp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="이야기"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="right|center_vertical"
                        android:text="이야기"
                        android:textColor="#80000000"
                        android:textSize="14dp" />

                </LinearLayout>


            </RelativeLayout>

        </RelativeLayout>

        <!-- 언어선택 영역 -->
        <RelativeLayout
            android:id="@+id/layout_lang"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_below="@id/tmp1"
            android:orientation="horizontal">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"
                android:background="#F6F6F6" />

            <!--언어 탭 레이아웃-->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_lang"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true"
                app:tabIndicatorColor="#00ffffff"
                app:tabIndicatorGravity="bottom"
                app:tabTextColor="#8d8d8d"
                app:tabSelectedTextColor="#ffffff"
                app:tabBackground="@drawable/tab_taxilang_background"
                app:tabTextAppearance="@style/TabTaxiLangText">
            </com.google.android.material.tabs.TabLayout>

        </RelativeLayout>

        <!-- 기존 리스트를 뷰로 재배치 (재생목록 없음 출력용 영역확보) ,layout_lang 과 layout_menu 의 순서변경시 below추가조정-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/layout_menu">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- 재생목록 혹은 다운로드 필요 알림 뷰, list 데이터 기준-->
            <LinearLayout
                android:id="@+id/list_empty"
                android:layout_centerVertical="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="72dp" android:contentDescription="TODO"
                    android:layout_height="80dp"
                    android:background="@drawable/tx_img_txlist_empty" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_list_empty"
                    android:layout_marginTop="32dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="재생목록이 비었습니다 오디오 이야기를 추가해 주세요"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="재생목록이 비었습니다\n오디오 이야기를 추가해 주세요"
                    android:textColor="#000000"
                    android:textSize="16dp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btn_list_action"
                    android:layout_marginTop="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:contentDescription="선택하기"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="선택하기"
                    android:textColor="#593bbd"
                    android:textSize="16dp" />

            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layout_bottom_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/view_toast"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="#E6696CFF"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="재생목록에 13 이야기가 추가되었습니다."
                android:textColor="#FFFFFF"
                android:textSize="14dp"
                android:visibility="gone" />

            <!--v2 색상변경 E6000000 to ff593bbd-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="#ff593bbd"
                android:paddingLeft="6dp"
                android:paddingTop="10dp"
                android:paddingRight="10dp"
                android:paddingBottom="10dp">

                <!-- v2 숨김 -->
                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/btn_bottom_menu_count"
                    android:layout_width="58dp"
                    android:layout_height="60dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_select_count"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:fontFamily="@font/vk_medium"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#2DCCD2"
                        android:textSize="14dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="이야기"
                        android:textColor="#FFFFFF"
                        android:textSize="14dp" />

                </LinearLayout>

                <!-- v2 가로크기 변경 58dp to wrap_content,
                android:layout_toRightOf="@id/btn_bottom_menu_count" 속성삭제
                orientation vertical to horizontal
                layout_centerHorizontal 추가
                paddingLeft,Right 추가
                -->
                <LinearLayout
                    android:layout_centerHorizontal="true"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:id="@+id/btn_bottom_menu_play"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginRight="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <!--
                    <ImageView
                        android:layout_width="30dp" android:contentDescription="TODO" 
                        android:layout_height="30dp"
                        android:background="@drawable/ic_tx_toast_01" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="안내시작"
                        android:textColor="#FFFFFF"
                        android:textSize="14dp" />
                    -->

                    <!-- 아이콘 변경
                    ic_tx_toast_01 to tx_img_txlist_play
                    backgroundTint 이미지 흰색 틴트처리 추가
                    layout_gravity 추가
                    -->
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="30dp" android:contentDescription="TODO"
                        android:layout_height="30dp"
                        android:background="@drawable/tx_img_txlist_play"
                        android:backgroundTint="#ffffff"/>
                    <!-- 높이 30dp to wrap_content, layout_gravity추가
                       layout_marginLeft 추가
                     -->
                    <TextView
                        android:layout_marginLeft="4dp"
                        android:layout_gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="자동재생"
                        android:textColor="#FFFFFF"
                        android:textSize="14dp" />
                </LinearLayout>

                <!-- v2 숨김 -->
                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/btn_bottom_menu_cancel"
                    android:layout_width="58dp"
                    android:layout_height="60dp"
                    android:layout_alignParentRight="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="30dp" android:contentDescription="TODO" 
                        android:layout_height="30dp"
                        android:background="@drawable/ic_tx_toast_close" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="취소"
                        android:textColor="#80FFFFFF"
                        android:textSize="14dp" />

                </LinearLayout>


            </RelativeLayout>


        </LinearLayout>

    </RelativeLayout>

</layout>