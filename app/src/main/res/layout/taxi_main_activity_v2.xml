<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.taxi.TaxiMainActivity">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <RelativeLayout
                android:id="@+id/layout_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible"
                tools:visibility="visible">

                <RelativeLayout
                    android:paddingTop="20dp"
                    android:id="@+id/topbar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp">

                    <!--숨김 -->
                    <ImageView
                        android:visibility="gone"
                        android:layout_width="44dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="20dp"
                        android:background="@drawable/ic_img_logo"
                        android:contentDescription="TODO" />

                    <!--@drawable/box_circle_gray_4dp-->
                    <TextView
                        android:text="Odii 관광택시"
                        android:textSize="16dp"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginLeft="20dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentLeft="true"
                        android:textColor="#ff000000"
                        android:background="#ffffff"
                        android:contentDescription="TODO" />

                    <!--
                    <ImageView
                        android:id="@+id/btn_help"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/ic_tx_bt_help"
                        android:contentDescription="TODO" />
                    -->
                    <TextView
                        android:id="@+id/btn_help"
                        android:textSize="16dp"
                        android:text="도움말"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginRight="20dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:textColor="#ff000000"
                        android:background="#ffffff"
                        android:contentDescription="TODO" />

                    <!--테스트 텍시모드 종료-->
                    <!--
                    <ImageView
                        android:backgroundTint="#ffff0000"
                        android:id="@+id/btn_quit_taxi_mode"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_toLeftOf="@id/btn_help"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/ic_tx_bt_help"
                        android:contentDescription="TODO" />
                    -->
                    <TextView
                        android:id="@+id/btn_quit_taxi_mode"
                        android:textSize="16dp"
                        android:text="Odii"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginRight="20dp"
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@id/btn_help"
                        android:textColor="#ff000000"
                        android:background="#ffffff"
                        android:contentDescription="TODO" />
                </RelativeLayout>

                <!-- 배경벽지 -->>
                <ImageView
                    android:id="@+id/iv_attr_pic"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:contentDescription="TODO" />

                <!-- 택시 로고 -->>
                <ImageView
                    android:id="@+id/iv_taxi_img"
                    android:layout_width="286dp"
                    android:layout_height="179dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="180dp"
                    android:background="@drawable/tx_img_txmain_logo"
                    android:contentDescription="TODO" />
                <!-- 택시 타이포로고 -->>
                <ImageView
                    android:id="@+id/iv_taxi_tyop"
                    android:layout_width="196dp"
                    android:layout_height="44dp"
                    android:layout_below="@id/iv_taxi_img"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/tx_img_txmain_typo"
                    android:contentDescription="TODO" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/iv_taxi_tyop"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="20dp"
                    android:fontFamily="sans-serif-light"
                    android:layout_centerHorizontal="true"
                    android:gravity="left|center_vertical"
                    android:text="춘천 관광택시"
                    android:textColor="#000000"
                    android:textSize="24dp" />

                <Button
                    android:id="@+id/btn_taxi_start"
                    android:layout_width="200dp"
                    android:layout_height="80dp"
                    android:background="@drawable/tx_img_txmain_start_bg"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/title"
                    android:layout_marginTop="48dp"
                    android:fontFamily="sans-serif-light"
                    android:paddingLeft="28dp"
                    android:drawableLeft="@drawable/r_tx_img_txmain_start_icon"
                    android:drawablePadding="8dp"
                    android:text="오디오 듣기"
                    android:textColor="#ffffff"
                    android:textSize="16dp"
                    android:gravity="left|center_vertical"
                    />

                <!-- v2 숨김 -->
                <TextView
                    android:visibility="gone"
                    android:id="@+id/tv_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/title"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/vk_medium"
                    android:gravity="left|center_vertical"
                    android:textColor="#000000"
                    android:textSize="16dp" />
                <!-- v2 숨김 -->
                <TextView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/title"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="20dp"
                    android:layout_toRightOf="@id/tv_count"
                    android:fontFamily="sans-serif-light"
                    android:gravity="left|center_vertical"
                    android:text="이야기"
                    android:textColor="#80000000"
                    android:textSize="16dp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_count"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <!-- 기본값 숨김 -->
                    <RelativeLayout
                        android:id="@+id/layout_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/box_taxi"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_script"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="50dp"
                            android:layout_marginRight="20dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="left|center_vertical"
                            android:paddingTop="20dp"
                            android:paddingBottom="20dp"
                            android:text="아래 다운로드 버튼을 눌러 각 언어별 오디오 해설 파일을 다운로드 받으시기 바랍니다.\n데이터 요금이 발생할 수 있으니 가급적 WiFi환경에서 다운로드 해주세요."
                            android:textColor="#696CFF"
                            android:textSize="15dp" />

                        <View
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:layout_alignTop="@id/tv_script"
                            android:layout_alignBottom="@id/tv_script"
                            android:background="@drawable/box_taxi_half_left_round" />

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/ic_tx_img_info"
                            android:contentDescription="TODO" />

                    </RelativeLayout>

                    <!-- v2 숨김 -->
                    <LinearLayout
                        android:id="@+id/layout_story_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D7D7D7" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="#F5F5F5" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D7D7D7" />

                        <RelativeLayout
                            android:id="@+id/btn_play"
                            android:layout_width="match_parent"
                            android:layout_height="168dp">

                            <TextView
                                android:id="@+id/tmp2"
                                android:layout_width="wrap_content"
                                android:layout_height="50dp"
                                android:layout_marginLeft="20dp"
                                android:gravity="left|center_vertical"
                                android:text="최근 재생 목록"
                                android:textColor="#000000"
                                android:textSize="16dp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/iv_thumb"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_below="@id/tmp2"
                                android:layout_marginLeft="20dp"
                                android:background="#FF0000"
                                android:contentDescription="TODO" />

                            <LinearLayout
                                android:id="@+id/tmp3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignTop="@id/iv_thumb"
                                android:layout_alignBottom="@id/iv_thumb"
                                android:layout_alignParentRight="true"
                                android:layout_marginRight="20dp"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/ic_tx_bt_mainplay"
                                    android:contentDescription="TODO" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignTop="@id/iv_thumb"
                                android:layout_alignBottom="@id/iv_thumb"
                                android:layout_marginLeft="20dp"
                                android:layout_marginRight="20dp"
                                android:layout_toLeftOf="@id/tmp3"
                                android:layout_toRightOf="@id/iv_thumb"
                                android:gravity="center_vertical"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_story_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="left|center_vertical"
                                    android:maxLines="2"
                                    android:singleLine="true"
                                    android:text="호반의 도시 이야기"
                                    android:textColor="#000000"
                                    android:textSize="18dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_lang"
                                        android:layout_width="wrap_content"
                                        android:layout_height="22dp"
                                        android:background="@drawable/box_driver_en"
                                        android:fontFamily="sans-serif-medium"
                                        android:gravity="center"
                                        android:paddingLeft="10dp"
                                        android:paddingRight="10dp"
                                        android:text="영어"
                                        android:textSize="13dp" />

                                    <TextView
                                        android:id="@+id/tv_story_play_time"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:fontFamily="sans-serif-medium"
                                        android:gravity="center"
                                        android:text="35:22"
                                        android:textColor="#898989"
                                        android:textSize="13dp" />


                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:layout_below="@id/iv_thumb"
                                android:gravity="center">

                                <ProgressBar
                                    android:id="@+id/progress"
                                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginLeft="20dp"
                                    android:layout_marginRight="20dp"
                                    android:max="100"
                                    android:progress="50"
                                    android:progressDrawable="@drawable/taxi_progressbar" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_empty"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#FFFFFF"
                                android:fontFamily="sans-serif-light"
                                android:gravity="center"
                                android:text="아직 재생된 이야기가 없습니다."
                                android:textColor="#80000000"
                                android:textSize="16dp" />

                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D7D7D7" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="#F5F5F5" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D7D7D7" />


                    </LinearLayout>

                    <!-- v2 숨김 -->
                    <TextView
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:text="다운로드 목록"
                        android:textColor="#000000"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <!-- v2 숨김 -->
                    <LinearLayout
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F5F5F5"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- 한국어 -->
                        <RelativeLayout
                            android:id="@+id/btn_ko"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginBottom="10dp"
                            android:background="#FFFFFF">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="20dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="left|center_vertical"
                                android:text="한국어"
                                android:textSize="18dp" />

                            <RelativeLayout
                                android:id="@+id/tmp4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="10dp">

                                <ImageView
                                    android:id="@+id/btn_down_ko"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/ic_tx_bt_down"
                                    android:contentDescription="TODO"
                                    android:visibility="visible" />

                                <ImageView
                                    android:id="@+id/btn_down_ko_complete"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/ic_tx_img_dlcomp"
                                    android:contentDescription="TODO"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/btn_upgrade_ko"
                                    android:layout_width="114dp"
                                    android:layout_height="30dp"
                                    android:layout_marginRight="4dp"
                                    android:background="@drawable/ic_tx_bt_updated"
                                    android:contentDescription="TODO"
                                    android:visibility="gone" />

                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tv_ko_file_size"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="20dp"
                                android:layout_toLeftOf="@id/tmp4"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="right|center_vertical"
                                android:textColor="#898989"
                                android:textSize="13dp" />


                        </RelativeLayout>

                        <!-- 영어 -->
                        <RelativeLayout
                            android:id="@+id/btn_en"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginBottom="10dp"
                            android:background="#FFFFFF">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="20dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="left|center_vertical"
                                android:text="영어"
                                android:textSize="18dp" />

                            <RelativeLayout
                                android:id="@+id/tmp5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="10dp">

                                <ImageView
                                    android:id="@+id/btn_down_en"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/ic_tx_bt_down"
                                    android:contentDescription="TODO"
                                    android:visibility="visible" />

                                <ImageView
                                    android:id="@+id/btn_down_en_complete"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/ic_tx_img_dlcomp"
                                    android:contentDescription="TODO"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/btn_upgrade_en"
                                    android:layout_width="114dp"
                                    android:layout_height="30dp"
                                    android:layout_marginRight="4dp"
                                    android:background="@drawable/ic_tx_bt_updated"
                                    android:contentDescription="TODO"
                                    android:visibility="gone" />

                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tv_en_file_size"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="20dp"
                                android:layout_toLeftOf="@id/tmp5"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="right|center_vertical"
                                android:textColor="#898989"
                                android:textSize="13dp" />


                        </RelativeLayout>

                        <!-- 중국어 -->
                        <RelativeLayout
                            android:id="@+id/btn_cn"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginBottom="10dp"
                            android:background="#FFFFFF">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="20dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="left|center_vertical"
                                android:text="중국어"
                                android:textSize="18dp" />

                            <RelativeLayout
                                android:id="@+id/tmp6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="10dp">

                                <ImageView
                                    android:id="@+id/btn_down_cn"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/ic_tx_bt_down"
                                    android:contentDescription="TODO"
                                    android:visibility="visible" />

                                <ImageView
                                    android:id="@+id/btn_down_cn_complete"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/ic_tx_img_dlcomp"
                                    android:contentDescription="TODO"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/btn_upgrade_cn"
                                    android:layout_width="114dp"
                                    android:layout_height="30dp"
                                    android:layout_marginRight="4dp"
                                    android:background="@drawable/ic_tx_bt_updated"
                                    android:contentDescription="TODO"
                                    android:visibility="gone" />

                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tv_cn_file_size"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="20dp"
                                android:layout_toLeftOf="@id/tmp6"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="right|center_vertical"
                                android:textColor="#898989"
                                android:textSize="13dp" />


                        </RelativeLayout>

                        <!-- 일본어 -->
                        <RelativeLayout
                            android:id="@+id/btn_jp"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginBottom="30dp"
                            android:background="#FFFFFF">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="20dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="left|center_vertical"
                                android:text="일본어"
                                android:textSize="18dp" />

                            <RelativeLayout
                                android:id="@+id/tmp7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="10dp">

                                <ImageView
                                    android:id="@+id/btn_down_jp"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/ic_tx_bt_down"
                                    android:contentDescription="TODO"
                                    android:visibility="visible" />

                                <ImageView
                                    android:id="@+id/btn_down_jp_complete"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/ic_tx_img_dlcomp"
                                    android:contentDescription="TODO"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/btn_upgrade_jp"
                                    android:layout_width="114dp"
                                    android:layout_height="30dp"
                                    android:layout_marginRight="4dp"
                                    android:background="@drawable/ic_tx_bt_updated"
                                    android:contentDescription="TODO"
                                    android:visibility="gone" />

                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tv_jp_file_size"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginRight="20dp"
                                android:layout_toLeftOf="@id/tmp7"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="right|center_vertical"
                                android:textColor="#898989"
                                android:textSize="13dp" />


                        </RelativeLayout>


                    </LinearLayout>


                </LinearLayout>
            </RelativeLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/indicator"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:visibility="gone"
            tools:visibility="visible" />
    </RelativeLayout>
</layout>