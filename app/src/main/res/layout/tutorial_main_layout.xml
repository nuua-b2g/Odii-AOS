<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="320dp"
            android:importantForAccessibility="no"
            android:layout_height="180dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="114dp"
            android:background="@drawable/ic_tutorial_bg" />

        <!-- -->
        <LinearLayout
            android:layout_alignParentTop="true"
            android:layout_marginTop="36dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:background="#AFA790">

            <!-- android:layout_above="@id/btn_tutorial_play" -->
            <kto.smarttour.common.utils.CustomViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginTop="76dp"
                android:layout_above="@id/layout_tutorial_bottom"
                />

            <!-- Relative Bottom -->
            <RelativeLayout
                android:id="@+id/layout_tutorial_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                tools:background="#4598FF99">

                <LinearLayout
                    android:id="@+id/tutorial_control_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <!-- page viewer indicator -->
                    <LinearLayout
                        android:id="@+id/layout_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:orientation="horizontal"
                        android:importantForAccessibility="yes">

                        <ImageView
                            android:id="@+id/view_pos_1"
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginRight="7dp"
                            android:importantForAccessibility="no"/>

                        <ImageView
                            android:id="@+id/view_pos_2"
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginRight="7dp"
                            android:importantForAccessibility="no"/>

                        <ImageView
                            android:id="@+id/view_pos_3"
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginRight="7dp"
                            android:importantForAccessibility="no"/>

                        <ImageView
                            android:id="@+id/view_pos_4"
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:importantForAccessibility="no"/>
                    </LinearLayout>

                    <!-- 다음 버튼 -->
                    <Button
                        android:id="@+id/tutorial_next_page_btn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:contentDescription="다음 가이드 화면 보기"
                        android:text="@string/tutorial_next_btn"
                        android:textSize="18sp"
                        android:textColor="@android:color/white"
                        android:background="#696CFF"
                        android:gravity="center"/>

                    <!-- 건너뛰기 -->
                    <TextView
                        android:id="@+id/tutorial_skip_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:contentDescription="가이드 화면 건너뛰기"
                        android:text="@string/tutorial_skip"
                        android:textSize="16sp"
                        android:textColor="#B0B0B0"
                        android:textAlignment="center"
                        android:layout_marginTop="16dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/btn_tutorial_play"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerInParent="true"
                    android:background="@drawable/tutorial_button_box"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:text="@string/tutorial_btn_text"
                    android:textColor="#FFFFFF"
                    android:textSize="16dp"
                    tools:visibility="visible"/>

            </RelativeLayout>

        </LinearLayout>

    </RelativeLayout>

</layout>
