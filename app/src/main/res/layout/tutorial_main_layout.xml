<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="320dp"
            android:importantForAccessibility="no"
            android:layout_height="180dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="114dp"
            android:background="@drawable/ic_tutorial_bg" />

        <!-- -->
        <LinearLayout
            android:layout_alignParentTop="true"
            android:layout_marginTop="76dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:background="#AFA790">

            <!-- android:layout_above="@id/btn_tutorial_play" -->
            <kto.smarttour.common.utils.CustomViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginTop="76dp"
                android:layout_above="@id/layout_tutorial_bottom"
                />

            <!-- Relative Bottom -->
            <RelativeLayout
                android:id="@+id/layout_tutorial_bottom"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                tools:background="#4598FF99">

                <LinearLayout
                    android:id="@+id/layout_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="20dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:orientation="horizontal"
                    android:importantForAccessibility="yes">

                    <ImageView
                        android:id="@+id/view_pos_1"
                        android:layout_width="16dp"
                        android:layout_height="2dp"
                        android:layout_marginRight="4dp"
                        android:background="#696CFF"
                        android:importantForAccessibility="no"/>

                    <ImageView
                        android:id="@+id/view_pos_2"
                        android:layout_width="16dp"
                        android:layout_height="2dp"
                        android:layout_marginRight="4dp"
                        android:background="#EBEBEB"
                        android:importantForAccessibility="no"/>

                    <ImageView
                        android:id="@+id/view_pos_3"
                        android:layout_width="16dp"
                        android:layout_height="2dp"
                        android:layout_marginRight="4dp"
                        android:background="#EBEBEB"
                        android:importantForAccessibility="no"/>

                    <ImageView
                        android:id="@+id/view_pos_4"
                        android:layout_width="16dp"
                        android:layout_height="2dp"
                        android:layout_marginRight="4dp"
                        android:background="#EBEBEB"
                        android:importantForAccessibility="no"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_tutorial_play"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/tutorial_button_box"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:text="@string/tutorial_btn_text"
                    android:textColor="#FFFFFF"
                    android:textSize="16dp"
                    tools:visibility="visible"/>

            </RelativeLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:contentDescription="가이드 화면 닫기"
            android:layout_height="32dp"
            android:layout_alignParentRight="true"
            android:layout_marginTop="22dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/ic_bt_top_closeb" />

    </RelativeLayout>

</layout>
